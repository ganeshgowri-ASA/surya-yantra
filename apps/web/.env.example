# Surya Yantra — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (PostgreSQL 15)
DATABASE_URL="postgres://user:password@host:5432/surya_yantra?sslmode=require"
DIRECT_URL="postgres://user:password@host:5432/surya_yantra?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AI
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."           # optional fallback

# Hardware (lab-only; leave blank for Vercel preview builds)
ESL_SOLAR_HOST="192.168.1.40"    # static IP of ESL-Solar 500
MUX_DRIVER_URL=""                 # e.g. https://mux.srishti.local or Cloudflare Tunnel URL

# Logging
LOG_LEVEL="info"
